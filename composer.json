{
    "name": "quillstack/router",
    "description": "The routing library working with PSR-7 requests.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "router",
        "routing",
        "routes",
        "php",
        "php7"
    ],
    "homepage": "https://quillstack.org/packages/router",
    "authors": [
        {
            "name": "Radek Ziemniewicz",
            "email": "radek@quillstack.org"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/http-message": "^1.0|^2.0",
        "psr/http-server-handler": "^1.0",
        "quillstack/http-request": "^0.6",
        "quillstack/server-request": "^0.8",
        "quillstack/uri": "^0.7"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "quillstack/unit-tests": "^0.9"
    },
    "autoload": {
        "psr-4": {
            "Quillstack\\Router\\": "src/",
            "Quillstack\\Router\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.6.x-dev"
        }
    },
    "scripts": {
        "test": "unit-tests",
        "test:coverage": "phpdbg -qrr vendor/bin/unit-tests",
        "stan": "phpstan analyse"
    }
}
