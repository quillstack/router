parameters:
	ignoreErrors:
		-
			message: '#^Method Quillstack\\Router\\Dispatcher\:\:getBranch\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Dispatcher.php

		-
			message: '#^Method Quillstack\\Router\\Route\:\:readParameterNames\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Route.php

		-
			message: '#^Offset ''colon'' on array\{0\: non\-falsy\-string, colon\: '''', 1\: '''', brace\: non\-falsy\-string, 2\: non\-falsy\-string\}\|array\{0\: non\-falsy\-string, colon\: non\-falsy\-string, 1\: non\-falsy\-string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Route.php

		-
			message: '#^Property Quillstack\\Router\\Route\:\:\$parameterNames type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Route.php

		-
			message: '#^Property Quillstack\\Router\\Route\:\:\$parameters type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Route.php

		-
			message: '#^Method Quillstack\\Router\\RouteTree\\RouteTreeBuilder\:\:add\(\) has parameter \$indexes with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/RouteTree/RouteTreeBuilder.php

		-
			message: '#^Method Quillstack\\Router\\RouteTree\\RouteTreeBuilder\:\:add\(\) has parameter \$tree with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/RouteTree/RouteTreeBuilder.php

		-
			message: '#^Method Quillstack\\Router\\RouteTree\\RouteTreeBuilder\:\:add\(\) never assigns null to &\$tree so it can be removed from the by\-ref type\.$#'
			identifier: parameterByRef.unusedType
			count: 1
			path: src/RouteTree/RouteTreeBuilder.php

		-
			message: '#^Method Quillstack\\Router\\RouteTree\\RouteTreeBuilder\:\:build\(\) has parameter \$tree with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/RouteTree/RouteTreeBuilder.php

		-
			message: '#^Parameter &\$tree by\-ref type of method Quillstack\\Router\\RouteTree\\RouteTreeBuilder\:\:build\(\) expects array, array\|null given\.$#'
			identifier: parameterByRef.type
			count: 1
			path: src/RouteTree/RouteTreeBuilder.php

		-
			message: '#^Method Quillstack\\Router\\RouteTree\\RouteTreeFinder\:\:findRoute\(\) has parameter \$branch with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/RouteTree/RouteTreeFinder.php

		-
			message: '#^Method Quillstack\\Router\\RouteTree\\RouteTreeFinder\:\:findRoute\(\) has parameter \$tree with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/RouteTree/RouteTreeFinder.php

		-
			message: '#^Method Quillstack\\Router\\RouteTree\\RouteTreeFinder\:\:walk\(\) has parameter \$branch with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/RouteTree/RouteTreeFinder.php

		-
			message: '#^Method Quillstack\\Router\\RouteTree\\RouteTreeFinder\:\:walk\(\) has parameter \$values with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/RouteTree/RouteTreeFinder.php

		-
			message: '#^Method Quillstack\\Router\\RouteTree\\RouteTreeFinder\:\:withValues\(\) has parameter \$values with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/RouteTree/RouteTreeFinder.php

		-
			message: '#^Method Quillstack\\Router\\Router\:\:getTree\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Router.php

		-
			message: '#^Property Quillstack\\Router\\Router\:\:\$routes type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Router.php

		-
			message: '#^Property Quillstack\\Router\\Router\:\:\$tree type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Router.php
